bg-lab/

# Concept 28: the agent's cwd (a.txt, b.txt) and its fake CLAUDE_CONFIG_DIR with the transcripts it resumes (recreated by the server)
errors-lab/

# Concept 29: the agent's cwd with the generated images and PDF, and its fake CLAUDE_CONFIG_DIR (recreated by the server)
files-lab/

# Concept 30: one folder per run (prices.csv and the files the agent writes) and the fake CLAUDE_CONFIG_DIR with the task lists (recreated by the server)
todo-lab/

# Concept 31: one empty folder per run (the files the agent writes) and the fake CLAUDE_CONFIG_DIR (recreated by the server)
ask-lab/

# Concept 32: one copy of the tiny project per run (cart.js, README.md) and the fake CLAUDE_CONFIG_DIR with the plan files (recreated by the server)
plan-lab/
